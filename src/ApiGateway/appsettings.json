{
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/identity" }]
      },
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/catalog/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/catalog" }]
      },
      "ordering": {
        "ClusterId": "ordering",
        "Match": { "Path": "/ordering/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/ordering" }]
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://identity-api:8080/" } } },
      "catalog": { "Destinations": { "d1": { "Address": "http://catalog-api:8080/" } } },
      "ordering": { "Destinations": { "d1": { "Address": "http://ordering-api:8080/" } } }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
